<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>World Planner</title>
<meta name="description" content="Design Growtopia worlds block by block: pencil, bucket, rectangle, select and mirror, stamps, material list, test walk, share by link. Works on phone and PC.">
<meta name="theme-color" content="#0d1420">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect x=%221%22 y=%221%22 width=%2230%22 height=%2230%22 rx=%228%22 fill=%22%231f2d44%22 stroke=%22%238ccbef%22 stroke-width=%222%22/%3E%3Cpath d=%22M5 13.5L9.5 8.5h13l4.5 5L16 27z%22 fill=%22%230f4466%22/%3E%3Cpath d=%22M9.5 8.5h13l4.5 5H5z%22 fill=%22%23b4e4fa%22/%3E%3Cpath d=%22M12.5 8.5h7l-1.5 5h-4z%22 fill=%22%23eaf8ff%22/%3E%3Cpath d=%22M5.6 13.5H16V26z%22 fill=%22%233fa7ff%22/%3E%3Cpath d=%22M16 13.5h10.4L16 26z%22 fill=%22%231f78d1%22/%3E%3Cpath d=%22M12 13.5h8L16 26z%22 fill=%22%236cc0ff%22/%3E%3Cpath d=%22M25.5 3.2l.9 2.2 2.2.9-2.2.9-.9 2.2-.9-2.2-2.2-.9 2.2-.9z%22 fill=%22%23ffe14a%22/%3E%3C/svg%3E">
<link rel="manifest" href="/edit/app/manifest.webmanifest">
<link rel="apple-touch-icon" href="/edit/app/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GT Simulator">
<link rel="stylesheet" href="wp.css?v=872f06bf12">
</head>
<body>
<main id="stage">
  <canvas id="wxb"></canvas>
  <canvas id="cv"></canvas>
  <canvas id="wxf"></canvas>
  <canvas id="ov"></canvas>

  <div id="topL" class="hud">
    <input id="wname" maxlength="24" spellcheck="false" autocomplete="off" aria-label="World name">
    <span id="wsize"></span>
    <nav id="siteNav" hidden><a href="/set/">Set</a><a href="/world/">World</a><a href="/edit/" class="on">Edit World</a></nav>
    <a id="siteDc" hidden href="https://discord.gg/piterp" target="_blank" rel="noopener" title="Discord" aria-label="Discord"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.6 5.6A16.4 16.4 0 0 0 15.5 4.3l-.5 1a15 15 0 0 0-6 0l-.5-1A16.4 16.4 0 0 0 4.4 5.6C1.8 9.5 1.1 13.2 1.4 16.9a16.6 16.6 0 0 0 5 2.6l1.1-1.7a10.6 10.6 0 0 1-1.7-.8l.4-.3a11.8 11.8 0 0 0 11.6 0l.4.3c-.5.3-1.1.6-1.7.8l1.1 1.7a16.5 16.5 0 0 0 5-2.6c.4-4.3-.7-8-2.9-11.3zM8.7 14.6c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2zm6.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2z"/></svg><span>Discord</span></a>
    <button id="siteInst" type="button" hidden>📲 <span>Install</span></button>
  </div>
  <div id="sideL">
    <button id="bArt" class="lt"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 16l5-5 4 4 3-3 6 6"/><circle cx="16" cy="9" r="1.6"/></svg><span data-t="artShort"></span></button>
    <button id="bSong" class="lt"><svg viewBox="0 0 24 24"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg><span data-t="songShort"></span></button>
    <button id="bWx" class="lt"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5"/></svg><span data-t="wxShort"></span></button>
    <button id="bMat" class="lt"><svg viewBox="0 0 24 24"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg><span data-t="matShort"></span></button>
  </div>
  <div id="topR" class="hud">
    <button id="bUndo" class="sq" data-tt="undo"><svg viewBox="0 0 24 24"><path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg></button>
    <button id="bRedo" class="sq" data-tt="redo"><svg viewBox="0 0 24 24"><path d="M15 14l5-5-5-5"/><path d="M20 9H10a6 6 0 0 0 0 12h3"/></svg></button>
    <button id="bMusic" class="sq" data-tt="musPlayT"><svg viewBox="0 0 24 24"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg></button>
    <button id="bPlay" class="sq" data-tt="play"><svg viewBox="0 0 24 24"><path d="M7 4l12 8-12 8z"/></svg></button>
    <button id="bMenu" class="menu" data-tt="menu"><img src="atlas/ui/dlg_menu_button.png?v=73fcffbb" alt=""></button>
  </div>

  <div id="acts">
    <div id="shapes">
      <button data-shape="dot"><svg viewBox="0 0 24 24"><rect x="8" y="8" width="8" height="8" rx="1" class="f"/></svg></button>
      <button data-shape="line"><svg viewBox="0 0 24 24"><path d="M5 19L19 5"/><rect x="3" y="17" width="4" height="4" class="f"/><rect x="17" y="3" width="4" height="4" class="f"/></svg></button>
      <button data-shape="rect"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1.5" class="f"/></svg></button>
      <button data-shape="rectO"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1.5"/><rect x="7" y="9" width="10" height="6" class="g"/></svg></button>
      <button data-shape="ellipse"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="9" ry="7" class="f"/></svg></button>
      <button data-shape="ellipseO"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="9" ry="7"/><ellipse cx="12" cy="12" rx="5" ry="3" class="g"/></svg></button>
      <button data-shape="fill"><svg viewBox="0 0 24 24"><path d="M5 11l7-7 7 7-7 7z"/><path d="M5 11h14"/><path d="M20 15c0 2 1 3 1 4a1 1 0 0 1-2 0c0-1 1-2 1-4"/></svg></button>
      <i class="sep"></i>
      <button id="symBtn" class="tog"><svg viewBox="0 0 24 24"><path d="M12 3v18" stroke-dasharray="2 2.5"/><path d="M9 7L4 12l5 5z" class="f"/><path d="M15 7l5 5-5 5z"/></svg></button>
    </div>
    <button id="mFx" class="rb sm"><canvas width="32" height="32"></canvas></button>
    <button id="mPlace" class="rb" data-mode="place"><canvas width="32" height="32"></canvas></button>
    <button id="mFist" class="rb" data-mode="fist"><canvas width="32" height="32"></canvas></button>
    <button id="mWrench" class="rb" data-mode="wrench"><canvas width="32" height="32"></canvas></button>
  </div>

  <div id="selbar" hidden>
    <button data-act="copy"></button><button data-act="cut"></button><button data-act="flip"></button><button data-act="stamp"></button><button data-act="mat"></button><button data-act="del"></button><button data-act="none" class="x">✕</button>
  </div>
  <div id="coords"><span id="stPos"></span><span id="stTile"></span><span id="stZoom"></span></div>
  <canvas id="mini" hidden></canvas>
  <div id="pad">
    <button data-k="left"><img src="atlas/ui/left_arrow.png?v=150fd871" alt="◀"></button>
    <button data-k="right"><img src="atlas/ui/right_arrow.png?v=bf493fca" alt="▶"></button>
    <span class="sp"></span>
    <button id="padStop"></button>
    <button data-k="jump"><img src="atlas/ui/jump_icon.png?v=393100d0" alt="▲"></button>
  </div>
</main>

<footer id="bag">
  <div id="itemName"></div>
  <div id="slots"></div>
  <button id="bagOpen"><svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span data-t="pack"></span></button>
</footer>

<section id="pack" aria-hidden="true">
  <div class="phead">
    <input id="q" type="search" spellcheck="false" autocomplete="off">
    <button id="packClose" class="xbtn"><img src="atlas/ui/dlg_cross.png?v=52da615a" alt="✕"></button>
  </div>
  <div id="chips"></div>
  <div id="grid"></div>
</section>

<div id="pop" hidden></div>
<div id="toast"></div>
<input id="file" type="file" hidden accept=".json,.dat,.pcap,.pcapng,.txt">

<script src="wp.app.js?v=839b8985f8"></script>
</body>
</html>
