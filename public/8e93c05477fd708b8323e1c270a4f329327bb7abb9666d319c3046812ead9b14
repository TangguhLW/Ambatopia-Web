/* CLOTHES: the panel, the dock on its top edge, the rail down its left edge */
html.gs.v2.g2-land:not(.g2-wear) #panel,html.gs.v2.g2-land:not(.g2-wear) #g2-rail,html.gs.v2.g2-land:not(.g2-wear) #g2-dock{display:none!important}
html.gs.v2.g2-land #panel{padding:var(--g2-lh) env(safe-area-inset-right) 0 var(--g2-lr);pointer-events:auto}   /* (pointer-events: the upright phone's "menu hidden" state, .gs-hid, does not count here) */
html.gs.v2.g2-land #g2-dock{z-index:8;left:calc(100vw - var(--gs-side) + 3px);right:env(safe-area-inset-right);top:var(--gs-top);bottom:auto;height:var(--g2-lh);gap:8px;padding:0 10px 0 8px;
  overflow-x:auto;overflow-y:hidden;touch-action:pan-x;background:none;border-top:0;border-bottom:2px solid var(--g2-line)}
html.gs.v2.g2-land #g2-slots{flex:none;align-self:auto;gap:3px;padding:6px 0 0;overflow:visible}
html.gs.v2.g2-land .g2-slot{flex:0 0 44px;max-width:none;height:46px}
html.gs.v2.g2-land .g2-slot.has{flex-basis:56px}              /* (a worn item: room for its picture's press -- settings -- beside the cross's 40 px) */
html.gs.v2.g2-land .g2-sx::after{inset:-9px}
html.gs.v2.g2-land .g2-si{--k:.6}
html.gs.v2.g2-land .g2-sl{font-size:9px}
html.gs.v2.g2-land .g2-div{height:36px}
html.gs.v2.g2-land .g2-ab{min-width:40px;height:40px;padding:0 7px}
html.gs.v2.g2-land .g2-ab .l{display:none}
html.gs.v2.g2-land #g2-rail{z-index:8;left:calc(100vw - var(--gs-side) + 3px);top:calc(var(--gs-top) + var(--g2-lh));bottom:0;width:var(--g2-lr);padding:3px 4px calc(8px + env(safe-area-inset-bottom));
  background:none;border-right:2px solid var(--g2-line)}
html.gs.v2.g2-land .g2-rgl{display:block;height:2px;margin:5px 8px;padding:0;font-size:0;line-height:0;border-radius:1px;background:var(--g2-line)}
html.gs.v2.g2-land .g2-rg:first-child .g2-rgl{display:none}
html.gs.v2.g2-land .g2-re{flex-direction:column;justify-content:center;height:44px;gap:2px;padding:0 1px}
html.gs.v2.g2-land .g2-re svg{width:18px;height:18px}
html.gs.v2.g2-land .g2-re span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;flex:none;max-width:100%;font-size:9.5px;line-height:1.05;font-weight:700;white-space:normal;text-align:center;overflow:hidden}
html.gs.v2.g2-land .g2-re em{display:none}
html.gs.v2.g2-land .g2-re.on{box-shadow:inset 3px 0 0 var(--pick)}
html.gs.v2.g2-land .pane{padding:8px 10px calc(8px + env(safe-area-inset-bottom))}
html.gs.v2.g2-land #g2{gap:6px}
html.gs.v2.g2-land .g2-hd{flex-direction:row;align-items:center;gap:6px}
html.gs.v2.g2-land .g2-ttl{flex:none;flex-direction:column;align-items:flex-start;justify-content:center;gap:0;min-width:64px;max-width:38%;min-height:40px}
html.gs.v2.g2-land #g2-title{font-size:13px;max-width:100%;overflow:hidden;text-overflow:ellipsis}
html.gs.v2.g2-land #g2-count{font-size:11.5px;flex:none}
html.gs.v2.g2-land #g2-q{height:40px}
html.gs.v2.g2-land #g2-qx{height:34px}
html.gs.v2.g2-land .g2-pt{font-size:13px}
html.gs.v2.g2-land .g2-row{display:flex;align-items:stretch;gap:6px;margin-bottom:6px}
html.gs.v2.g2-land .g2-rl{flex:0 0 46px;flex-direction:column;justify-content:center;gap:2px;min-height:0;padding:2px 0;border-radius:8px;background:var(--navy);box-shadow:inset 0 0 0 2px var(--navy2);letter-spacing:0}
html.gs.v2.g2-land .g2-rl span{display:none}
html.gs.v2.g2-land .g2-rl em{flex:none;font-size:11px}
html.gs.v2.g2-land .g2-rl svg{width:16px;height:16px}
html.gs.v2.g2-land .g2-ed{height:20px;padding:0 6px;font-size:10px;text-transform:none}
html.gs.v2.g2-land .g2-ed::after{inset:-10px -4px}
html.gs.v2.g2-land .g2-rs{flex:1;min-width:0;padding:3px}
/* the settings box: shut = its one title line under the list; open = it takes the list's place (gs_ui2.js cfg: .g2-cfgo) */
html.gs.v2.g2-land #g2-cfgw{max-height:none}
html.gs.v2.g2-land #g2.g2-cfgo #g2-sc{display:none}
html.gs.v2.g2-land #g2.g2-cfgo #g2-cfgw{flex:1;min-height:0}
html.gs.v2.g2-land #g2-sets{top:calc(var(--gs-top) + 6px);bottom:auto;right:max(8px,env(safe-area-inset-right));max-height:calc(100vh - var(--gs-top) - 14px);max-height:calc(100dvh - var(--gs-top) - 14px);padding:10px;gap:8px}
html.gs.v2.g2-land #gs-toast{top:calc(var(--gs-top) + 50px)}

/* the World page (/world/, gs_ui.js worldPage: <html class="gs-worldpage">): nothing of the Set page's v2 shows, the scene takes the room */
html.gs-worldpage #g2-rail,html.gs-worldpage #g2-dock,html.gs-worldpage #g2-slots,html.gs-worldpage #g2-sets{display:none!important}
html.gs.v2.gs-worldpage{--g2-col:0px;--g2-dockh:0px}

/* r63: the character canvas must not ease to its place (0.22 s of #stage canvas) -- the shadow is drawn at once, so the body trailed it after every fit() */
.gs #stage #char{transition:none}
