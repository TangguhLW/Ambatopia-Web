/* UI v2 of the "Growtopia Simulator" skin (audit\UI_V2_BRIEF.md; gs_ui2.js). Loaded after gs_ui.css and only where
   <html class="gs v2"> is set (index.html: ?v2=1 once), so every rule starts with html.gs.v2 or names a #g2- / .g2- part
   that only gs_ui2.js makes. The owner's layout of 2026-10-13: the RAIL (#g2-rail: Clothes / Look / Name entries) is the
   one navigation, the PANEL shows the chosen entry's content, the DOCK (#g2-dock) shows what is worn + the actions.
   Layouts as in gs_ui.css: SIDE (wide: rail = a column at the left, dock = a bar under the scene, panel at the right)
   and SHEET (phone: dock, handle, rail = rows on top of the bottom sheet, the content under them).
   THE LOOK = the World Planner's (wp.css, /setplanner/world): the same tokens (names and values below), its light-blue
   buttons with dark-blue ink and edge, its dark inventory boxes with a light frame, yellow = chosen, its panels.
   Radii as there: 6 - 8 boxes, 10 - 12 buttons and fields, 14 panels and popovers, 99 pills. */
html.gs.v2{
  --navy: #1f2d44; --navy2: #2a3b57; --slot: #26344d; --frame: #8ccbef; --pick: #ffe14a;
  --btn: #b4e4fa; --btn2: #d6f1fd; --ink: #165c86; --edge: #0f4466; --text: #f3f8ff; --dim: #a9bdd6; --bad: #ff6464;
  --font: "Trebuchet MS", "Segoe UI", system-ui, sans-serif;
  /* the names the page and the old skin read, pointed at the tokens above (v2 only) */
  --g2-line:#3e5a80;--g2-ring:rgba(255,225,74,.35);--g2-drop:rgba(0,0,0,.35);--g2-pop:rgba(23,34,54,.97);--g2-bar:linear-gradient(#2b3d5b,#1f2d44);
  --gs-bg:var(--navy);--gs-card:var(--navy2);--gs-line:var(--g2-line);--gs-acc:var(--pick);--gs-green:var(--pick);
  --stage:#0c1422;--panel:var(--navy);--well:var(--slot);--well-on:var(--slot);--gold:var(--pick);
  --g2-col:152px;--g2-dockh:80px;--g2-well:var(--slot);--g2-well2:var(--navy2);--g2-txt2:var(--text);--g2-th:90px}
html.gs.v2 body{font-family:var(--font);font-weight:600}
html.gs.v2 button,html.gs.v2 input,html.gs.v2 select{font-family:var(--font)}
html.gs.v2 button:disabled{opacity:.45;cursor:default}
html.gs.v2 #emotes{visibility:hidden;pointer-events:none;left:8px;right:auto;width:44px;height:44px;padding:0;overflow:hidden}   /* out of sight; it keeps its place so the chat console still starts under it */

/* ---- top bar: the World Planner's backpack bar, its square light-blue buttons ---- */
html.gs.v2 #gs-bar{gap:6px;background:var(--g2-bar);border-bottom:3px solid var(--frame)}
html.gs.v2 .gs-brand b i{color:var(--pick)}
html.gs.v2 #gs-bar .gs-ib{min-width:40px;height:40px;padding:0 8px;gap:6px;border:3px solid var(--edge);border-radius:12px;background:var(--btn);color:var(--ink);font-weight:800;box-shadow:0 3px 0 var(--g2-drop)}
html.gs.v2 #gs-bar .gs-ib svg{width:20px;height:20px;stroke-width:2.6}
html.gs.v2 #gs-bar .gs-ib:hover{background:var(--btn2)}
html.gs.v2 #gs-bar .gs-ib:active{transform:translateY(2px);box-shadow:0 1px 0 var(--g2-drop)}
html.gs.v2 #gs-bar .gs-ib.on{background:var(--pick)}
html.gs.v2 #gs-bar .gs-ib:disabled{pointer-events:none}
html.gs.v2 #gs-lang s{color:#5b8fb0}
html.gs.v2 #gs-bar #gs-more{min-width:44px;height:44px;padding:0;border:0;background:none;box-shadow:none;color:var(--text);filter:drop-shadow(0 3px 0 var(--g2-drop))}   /* the game's own menu picture, as on the World Planner */
html.gs.v2 #gs-bar #gs-more:active{box-shadow:none}
html.gs.v2 #gs-menu #g2-m-lang,html.gs.v2 #gs-menu #g2-m-snd{display:none}
@media (max-width:620px){
  html.gs.v2 #gs-lang,html.gs.v2 #gs-snd{display:none}
  html.gs.v2 #gs-menu #g2-m-lang,html.gs.v2 #gs-menu #g2-m-snd:not([hidden]){display:flex}
  html.gs.v2 .gs-brand b{display:none}
  html.gs.v2 #gs-bar{gap:5px}
}
/* the "more" menu and the toast: the World Planner's dialog and its toast */
html.gs.v2 #gs-menu{border:3px solid var(--frame);border-radius:14px;background:var(--g2-pop);box-shadow:0 12px 40px rgba(0,0,0,.55);padding:8px}
html.gs.v2 #gs-menu button{border-radius:8px;font-weight:600}
html.gs.v2 #gs-menu button:hover{background:var(--navy2)}
html.gs.v2 #gs-menu p b{color:var(--pick)}
html.gs.v2 #gs-toast{background:var(--btn);color:var(--ink);border:3px solid var(--edge);border-radius:12px;padding:8px 14px;font-weight:800}
html.gs.v2 #gs-keys kbd{background:rgba(15,25,42,.85);border-color:var(--g2-line)}
html.gs.v2 #gs-foot{border-top:2px solid var(--g2-line)}
html.gs.v2 #gs-show{border:2px solid var(--frame);background:rgba(15,25,42,.85);color:var(--text)}

/* ---- the panel: gs_ui.js's tab row stays out of sight (the rail is the navigation) ---- */
html.gs.v2 #panel{background:var(--g2-bar);border-top:3px solid var(--frame);border-radius:14px 14px 0 0}
html.gs.v2 #gs-tabs{display:none}
html.gs.v2 #gs-grab{height:22px}
html.gs.v2 #gs-grab::before{background:var(--frame);opacity:.7}
html.gs.v2 #gs-hide{top:-4px;right:4px;width:44px;height:30px;color:var(--dim)}
html.gs.v2 #gs-hide::after{content:'';position:absolute;inset:-5px 0}
.g2-pt{flex:none;font-size:15px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--pick)}

/* ---- the rail (base = the phone's: one row scrolled sideways, the group names small labels that stay in sight) ---- */
#g2-rail{position:relative;display:flex;gap:12px;flex:none;padding:0 12px 8px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;touch-action:pan-x;overscroll-behavior:contain}
#g2-rail::-webkit-scrollbar,#g2-dock::-webkit-scrollbar,#g2-slots::-webkit-scrollbar{display:none}
.g2-rg{flex:none;display:flex;flex-direction:column;gap:3px}
.g2-rgl{position:sticky;left:0;align-self:flex-start;padding-right:8px;font-size:9.5px;line-height:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
.g2-rgi{display:flex;gap:6px}
.g2-re{position:relative;flex:none;display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 13px 0 10px;border:2px solid var(--g2-line);border-radius:99px;background:var(--slot);color:var(--dim);
  cursor:pointer;font-size:12.5px;font-weight:800;white-space:nowrap;-webkit-tap-highlight-color:transparent}
.g2-re svg{flex:none;width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.g2-re em{display:none;font-style:normal;font-size:10.5px;font-weight:600;color:var(--dim)}
.g2-re:hover{border-color:var(--frame);color:#fff}
.g2-re.on{border-color:var(--pick);color:var(--pick);box-shadow:inset 0 -3px 0 var(--pick)}

/* ---- the dock: what is worn (the World Planner's inventory boxes) and the actions (base = the phone's: one row scrolled sideways) ---- */
#g2-dock{position:relative;display:flex;align-items:center;gap:8px;flex:none;padding:10px 12px 2px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;touch-action:pan-x;overscroll-behavior:contain}
#g2-slots{position:relative;display:flex;gap:6px;flex:none}
.g2-div{flex:none;width:2px;height:44px;border-radius:1px;background:var(--g2-line)}
#g2-acts{display:flex;align-items:center;gap:6px;flex:none}
.g2-ab{flex:none;min-width:44px;height:44px;padding:0 9px;display:inline-flex;align-items:center;justify-content:center;gap:6px;border:3px solid var(--edge);border-radius:12px;background:var(--btn);color:var(--ink);
  cursor:pointer;font-size:13px;font-weight:800;white-space:nowrap;box-shadow:0 3px 0 var(--g2-drop);-webkit-tap-highlight-color:transparent}
.g2-ab svg{flex:none;width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.g2-ab .l{display:none}
.g2-ab:hover{background:var(--btn2)}
.g2-ab:active{transform:translateY(2px);box-shadow:0 1px 0 var(--g2-drop)}
.g2-ab.on{background:var(--pick)}
.g2-ab:disabled{pointer-events:none}
#g2-reset:hover{background:#ffb3b3;border-color:#a12a2a;color:#5a0d0d}
.g2-slot{position:relative;flex:0 0 58px;height:60px}
.g2-sb{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;padding:2px 1px 1px;border:3px solid var(--g2-line);border-radius:8px;
  background:var(--slot);color:var(--dim);cursor:pointer;-webkit-tap-highlight-color:transparent;transition:border-color .12s,background-color .12s}
div.g2-sb{cursor:default}                                     /* the slots show what is worn; only an item with settings is a button */
button.g2-sb:hover{border-color:var(--pick);color:#fff}
button.g2-sb:active{background:var(--navy2)}
.g2-si{--k:.75;position:relative;flex:none;display:block;width:calc(48px * var(--k));height:calc(48px * var(--k))}
.g2-si i{position:absolute;left:0;top:0;display:block;width:48px;height:48px;transform:scale(var(--k));transform-origin:0 0;image-rendering:pixelated;background-repeat:no-repeat}
.g2-si svg{display:block;width:24px;height:24px;margin:calc(24px * var(--k) - 12px);fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;opacity:.6}
.g2-sl{max-width:100%;font-size:10px;line-height:1.3;font-weight:800;letter-spacing:.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.g2-slot.has .g2-sb{color:var(--text);border-color:var(--frame)}
.g2-slot:not(.has) .g2-sb{border-style:dashed}
.g2-slot.hc .g2-sb::before{content:'\2699';position:absolute;left:5px;top:4px;font:700 11px/1 system-ui,sans-serif;color:var(--pick)}
.g2-sx{position:absolute;top:-5px;right:-5px;width:22px;height:22px;padding:0;display:flex;align-items:center;justify-content:center;border:2px solid var(--bad);border-radius:50%;
  background:var(--navy);color:var(--bad);cursor:pointer}
.g2-sx::after{content:'';position:absolute;inset:-10px}       /* a 40 px target around the small cross */
.g2-sx svg{width:10px;height:10px;fill:none;stroke:currentColor;stroke-width:3.4;stroke-linecap:round}
.g2-sx:hover{background:var(--bad);color:#fff}

/* ---- the clothes entry: the title, the search, the list ---- */
html.gs.v2 #pop-clothes{overflow:hidden}
html.gs.v2 #pop-clothes>:not(#g2){display:none!important}
#g2{flex:1;min-height:0;display:flex;flex-direction:column;gap:8px}
.g2-hd{flex:none;display:flex;flex-direction:column;gap:8px;min-width:0}
.g2-ttl{display:flex;align-items:center;gap:8px;min-height:24px;min-width:0}
#g2-title{font-size:15px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--pick);white-space:nowrap}
#g2-count{font-size:13px;font-weight:600;color:var(--dim);flex:1;white-space:nowrap}
.g2-q{position:relative;display:flex;align-items:center;flex:1;min-width:0}
.g2-q>svg{position:absolute;left:13px;width:18px;height:18px;fill:none;stroke:var(--frame);stroke-width:2.4;stroke-linecap:round;pointer-events:none}
#g2-q{width:100%;height:44px;padding:0 44px 0 38px;border:3px solid var(--frame);border-radius:10px;background:var(--slot);font-size:16px;font-weight:600;color:var(--text)}
#g2-q::placeholder{color:var(--dim);opacity:.85}
#g2-q:hover{filter:brightness(1.1)}
html.gs.v2 #g2-q:focus,html.gs.v2 #g2-q:focus-visible{border-color:var(--pick);outline:0;box-shadow:0 0 0 2px var(--g2-ring)}
#g2-qx{position:absolute;right:3px;width:40px;height:38px;padding:0;display:flex;align-items:center;justify-content:center;border:0;border-radius:8px;background:none;color:var(--dim);cursor:pointer}
#g2-qx[hidden]{display:none}
#g2-qx::after{content:'';position:absolute;inset:-1px 0}
#g2-qx svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}
#g2-qx:hover{color:#fff;background:var(--navy2)}
#g2-sc{position:relative;flex:1;min-height:96px;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;margin-right:-6px;padding-right:6px;scrollbar-width:thin;scrollbar-color:var(--g2-line) transparent}
#g2-vg{position:relative}
#g2-win{position:absolute;left:0;right:0;top:0;display:grid;gap:6px;will-change:transform}
#g2-none{margin:16px 0;text-align:center;font-size:13px;font-weight:600;color:var(--dim)}
#g2-none[hidden]{display:none}
.g2-it{position:relative;height:var(--g2-th);min-width:0}
.g2-w{width:100%;height:100%;min-width:0;display:flex;flex-direction:column;align-items:center;gap:3px;padding:4px 1px 2px;border:3px solid var(--g2-line);border-radius:8px;background:var(--slot);
  color:var(--text);cursor:pointer;-webkit-tap-highlight-color:transparent;transition:border-color .12s,background-color .12s}
.g2-w:hover{border-color:var(--frame)}
.g2-w:active{background:var(--navy2)}
.g2-w i,.g2-mi i{flex:none;display:block;width:48px;height:48px;image-rendering:pixelated;background-repeat:no-repeat}
.g2-n{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;overflow:hidden;max-width:100%;font-size:10.5px;line-height:1.2;font-weight:600;text-align:center;overflow-wrap:anywhere}
.g2-w em{max-width:100%;margin-top:auto;padding:1px 6px;border-radius:99px;background:var(--navy);color:var(--frame);font-style:normal;font-size:9px;line-height:1.3;font-weight:800;letter-spacing:.05em;
  text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.g2-it.on .g2-w{border-color:var(--pick);box-shadow:0 0 0 2px var(--g2-ring);color:#fff}
.g2-it.hc::before{content:'\2699';position:absolute;z-index:1;left:7px;top:6px;font:700 12px/1 system-ui,sans-serif;color:var(--pick);pointer-events:none}
.g2-it.nb .g2-w i{opacity:.4}
.g2-it.nb::after{content:'';position:absolute;left:8px;bottom:8px;width:6px;height:6px;border-radius:50%;background:var(--bad);pointer-events:none}
.g2-star{position:absolute;top:2px;right:2px;width:26px;height:26px;padding:4px;display:flex;align-items:flex-start;justify-content:flex-end;border:0;border-radius:0 6px 0 8px;background:none;color:#6f8db5;cursor:pointer}
.g2-star svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linejoin:round}
.g2-star:hover{color:var(--pick)}
.g2-star.on{color:var(--pick)}
.g2-star.on svg{fill:currentColor}
@media (hover:hover) and (pointer:fine){.g2-star:not(.on){opacity:0}.g2-it:hover .g2-star,.g2-star:focus-visible{opacity:1}}
@media (pointer:coarse){.g2-star{width:40px;height:40px;top:0;right:0;padding:6px}}

/* "Favourites" and "Recently worn": one line each, inside the list's own scroll */
.g2-row{margin-bottom:8px}
.g2-rl{display:flex;align-items:center;gap:6px;min-height:24px;font-size:11px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:var(--dim)}
.g2-rl em{font-style:normal;font-weight:600;color:var(--dim);opacity:.8;flex:1}
.g2-rl svg{flex:none;width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.g2-row[data-row=fav] .g2-rl svg{color:var(--pick);fill:currentColor}
.g2-ed{height:24px;padding:0 10px;border:2px solid var(--navy2);border-radius:99px;background:var(--slot);color:var(--dim);cursor:pointer;font-size:11px;font-weight:800;position:relative}
.g2-ed::after{content:'';position:absolute;inset:-8px -4px}
.g2-ed:hover{border-color:var(--frame);color:#fff}
.g2-rs{display:flex;gap:6px;overflow-x:auto;overflow-y:hidden;padding:3px 3px 5px;scrollbar-width:none;overscroll-behavior-x:contain}
.g2-rs::-webkit-scrollbar{display:none}
.g2-mi{position:relative;flex:none;width:54px;height:54px;padding:0;display:flex;align-items:center;justify-content:center;border:3px solid var(--g2-line);border-radius:6px;background:var(--slot);cursor:pointer}
.g2-mi:hover{border-color:var(--frame)}
.g2-mi.on{border-color:var(--pick);box-shadow:0 0 0 2px var(--g2-ring)}
.g2-row.ed .g2-mi{border-color:var(--bad);border-style:dashed;box-shadow:none}
.g2-row.ed .g2-mi::after{content:'\00d7';position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:var(--bad);color:#fff;font:700 13px/18px system-ui,sans-serif;text-align:center}
.g2-row.ed .g2-ed{background:var(--btn);border-color:var(--edge);color:var(--ink)}

/* the settings of the chosen slot's item, under the list */
#g2-cfgw{flex:none;display:flex;flex-direction:column;max-height:40%;border:2px solid var(--frame);border-radius:12px;background:var(--g2-pop);overflow:hidden}
#g2-cfgw[hidden]{display:none}
#g2-cfgh{flex:none;display:flex;align-items:center;gap:8px;width:100%;min-height:40px;padding:0 12px;border:0;background:none;color:var(--pick);cursor:pointer;font-size:13px;font-weight:800;text-align:left}
#g2-cfgh span{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#g2-cfgh svg{flex:none;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
#g2-cfgh svg:last-child{color:var(--dim);transition:transform .15s}
#g2-cfgh:hover{background:var(--navy2)}
html.gs.v2 #g2-cfgh:focus-visible{outline-offset:-3px}
#g2-cfgw.shut #g2-cfgh svg:last-child{transform:rotate(-90deg)}
#g2-cfgw.shut #g2-cfg{display:none}
#g2-cfgw.flash{animation:g2-flash .7s ease-out}                /* its slot was pressed: here it is */
@keyframes g2-flash{0%{border-color:var(--pick);box-shadow:0 0 0 4px var(--g2-ring)}100%{border-color:var(--frame);box-shadow:0 0 0 0 transparent}}
#g2-cfg{min-height:0;overflow-y:auto;overscroll-behavior:contain;border-top:2px solid var(--g2-line);scrollbar-width:thin;scrollbar-color:var(--g2-line) transparent}
html.gs.v2 #g2-cfg .cfg{display:flex;flex-wrap:wrap;white-space:normal;margin:0;gap:8px;padding:10px 12px 12px;border-radius:0;background:none;font-size:13px}
html.gs.v2 #g2-cfg .cfg button{min-height:40px;padding:0 12px;opacity:1;border:2px solid var(--g2-line);border-radius:8px;background:var(--slot);color:var(--text)}
html.gs.v2 #g2-cfg .cfg button:hover{border-color:var(--frame)}
html.gs.v2 #g2-cfg .cfg button.on{border-color:var(--pick);color:var(--pick);background:var(--slot)}
html.gs.v2 #g2-cfg .cfg label{min-height:40px;gap:8px;flex-wrap:wrap;opacity:1;color:var(--dim)}
html.gs.v2 #g2-cfg .cfg select{height:40px;max-width:100%;padding:0 8px;background:var(--slot);border:2px solid var(--frame);border-radius:8px;color:var(--text)}
html.gs.v2 #g2-cfg .cfg input[type=color]{width:48px;height:36px;border:2px solid var(--frame);border-radius:8px;background:var(--slot)}
html.gs.v2 #g2-cfg .cfg input[type=range]{flex:1 1 90px;min-width:90px;max-width:180px;height:36px;accent-color:var(--pick)}

/* ---- the other panes (Look, Name): the page's own content in the same boxes, ONE section at a time. gs_ui2.js marks
   each control with its section (data-sec) and the pane with the chosen one (data-show); nothing is moved ---- */
html.gs.v2 #pop-skin[data-show="skin"]>[data-sec]:not([data-sec~="skin"]),html.gs.v2 #pop-skin[data-show="skin"] #gs-look>[data-sec]:not([data-sec~="skin"]){display:none!important}
html.gs.v2 #pop-skin[data-show="hair"]>[data-sec]:not([data-sec~="hair"]),html.gs.v2 #pop-skin[data-show="hair"] #gs-look>[data-sec]:not([data-sec~="hair"]){display:none!important}
html.gs.v2 #pop-skin[data-show="eyes"]>[data-sec]:not([data-sec~="eyes"]),html.gs.v2 #pop-skin[data-show="eyes"] #gs-look>[data-sec]:not([data-sec~="eyes"]){display:none!important}
html.gs.v2 #pop-skin[data-show="fx"]>[data-sec]:not([data-sec~="fx"]),html.gs.v2 #pop-skin[data-show="fx"] #gs-look>[data-sec]:not([data-sec~="fx"]){display:none!important}
html.gs.v2 #subtabs{display:none!important}                    /* (the page's own switch of the Name lists: pressed by the rail) */
html.gs.v2 #pop-name:not([data-show="name"]) #pname{display:none!important}
html.gs.v2 #pop-name[data-show="name"] #sub-title>:not([data-sec="name"]),html.gs.v2 #pop-name[data-show="titles"] #sub-title>:not([data-sec="titles"]){display:none!important}
html.gs.v2 #pop-name[data-show="name"] #sub-role{display:flex!important}   /* Name = the field, the name colour, the role icon */
html.gs.v2 #pop-name[data-show="name"] .sub{flex:none}
html.gs.v2 #gs-look .chips{min-height:44px}
html.gs.v2 .pane .h{margin-top:4px;font-weight:800;letter-spacing:.6px;color:var(--dim)}
