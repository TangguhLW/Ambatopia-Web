/* The "Growtopia Simulator" skin: only where <html class="gs"> is set (index.html: the growtopiasimulator.com
   host, or ?ui=gs on localhost). Every rule starts with html.gs, so the page is untouched everywhere else.
   Two layouts: SHEET (default: a bottom sheet over the lower part of the screen) and SIDE (a fixed panel at the
   right: wide windows and phones held sideways). The stage is never resized by the sheet: the sheet lies over it and
   the invisible .dock box tells the page's camera where the free area ends (planner.js barTop measures .dock). */
html.gs{--gs-top:calc(48px + env(safe-area-inset-top));--gs-side:clamp(300px,34vw,440px);--gs-sheet:50vh;--gs-tallh:72vh;--gs-head:82px;
  --gs-bg:#12141b;--gs-card:#1c202b;--gs-line:#2d3344;--gs-acc:#ffc94d;--gs-green:#4fd08a;-webkit-text-size-adjust:100%}
html.gs body{font-weight:500}
html.gs .top,html.gs #panel>header,html.gs #mutebtn,html.gs #src,html.gs #viewfull,html.gs .gs-x{display:none!important}
html.gs #stage{top:var(--gs-top)}
html.gs .dock{display:block;visibility:hidden;pointer-events:none;left:0;right:0;bottom:0;height:var(--gs-open,50vh);padding:0}html.gs button:focus-visible,html.gs input:focus-visible{outline:2px solid var(--gs-acc);outline-offset:1px}

/* ---- top bar ---- */
#gs-bar{position:fixed;top:0;left:0;right:0;height:var(--gs-top);z-index:8;display:flex;align-items:center;gap:2px;
  padding:env(safe-area-inset-top) max(6px,env(safe-area-inset-right)) 0 max(12px,env(safe-area-inset-left));
  background:var(--gs-bg);border-bottom:1px solid var(--gs-line)}
.gs-brand{display:flex;align-items:center;gap:9px;flex:1;min-width:0;font-weight:800;font-size:15px;line-height:1.05;letter-spacing:.01em}
.gs-brand svg{flex:none;width:28px;height:28px}
.gs-brand b{font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gs-brand b i{font-style:normal;color:var(--gs-green)}
.gs-ib{flex:none;min-width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:0 10px;border:0;border-radius:11px;
  background:none;color:var(--text);cursor:pointer;font-size:13px;font-weight:600;-webkit-tap-highlight-color:transparent}
.gs-ib:hover{background:var(--gs-card)}
.gs-ib:active{background:var(--gs-line)}
.gs-ib svg,.gs-tab svg{flex:none;width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.gs-ib .l{display:none}
.gs-ib[hidden]{display:none}
#gs-lang{font-weight:800;letter-spacing:.04em}
#gs-lang s{text-decoration:none;color:var(--dim);font-weight:600}
@media(max-width:430px){.gs-brand b{white-space:normal;font-size:13px}.gs-brand b i{display:block}}
#gs-toast{position:fixed;top:calc(var(--gs-top) + 58px);left:50%;transform:translate(-50%,-8px);z-index:20;padding:10px 16px;border-radius:999px;background:#0b0d12;
  border:1px solid var(--gs-line);font-size:13px;opacity:0;pointer-events:none;transition:opacity .18s,transform .18s;white-space:nowrap}
#gs-toast.on{opacity:1;transform:translate(-50%,0)}

/* the "more" menu (a native popover; .open = the fallback where the browser has none) */
#gs-menu{position:fixed;inset:calc(var(--gs-top) + 4px) max(8px,env(safe-area-inset-right)) auto auto;margin:0;width:min(300px,calc(100vw - 16px));padding:6px;
  border:1px solid var(--gs-line);border-radius:14px;background:var(--gs-bg);color:var(--text);box-shadow:0 14px 40px rgba(0,0,0,.55);z-index:30}
#gs-menu:not([popover]){display:none}
#gs-menu.open{display:block}
#gs-menu button{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:44px;padding:0 12px;border:0;border-radius:10px;background:none;
  color:inherit;cursor:pointer;text-align:left;font-size:14px}
#gs-menu button:hover{background:var(--gs-card)}
#gs-menu button[hidden]{display:none}
#gs-menu button em{font-style:normal;font-size:12px;color:var(--dim)}
#gs-menu button.on em{color:var(--gs-acc)}
#gs-menu p,#gs-foot{margin:6px 12px 8px;font-size:11.5px;line-height:1.45;color:var(--dim);font-weight:400}
#gs-menu p b{display:block;color:var(--text);font-size:13px;margin-bottom:2px}
#gs-foot{display:none;flex:none;margin:0;padding:8px 14px calc(8px + env(safe-area-inset-bottom));border-top:1px solid var(--gs-line)}

/* ---- on the stage: emotes, zoom, move pads, key hints ---- */
html.gs #emotes{top:calc(var(--gs-top) + 6px);left:max(8px,env(safe-area-inset-left));right:calc(112px + env(safe-area-inset-right));height:44px}
html.gs #emotes button{height:44px;min-width:44px;border-radius:11px;background:rgba(18,20,27,.82)}
html.gs .zoom{top:calc(var(--gs-top) + 6px);right:max(10px,env(safe-area-inset-right))}
html.gs .zoom .btn{width:44px;height:44px;border-radius:11px;background:rgba(18,20,27,.82);border-color:var(--gs-line)}
/* the client's button look on the stage buttons (gs_ui.js: fill 135,184,204 + game/gui_box_upwhite, 0x1732fa8) */
html.gs.gs-hud #emotes button,html.gs.gs-hud .zoom .btn{border-radius:0;background:rgb(135,184,204);color:#fff;text-shadow:1px 1px 0 rgba(0,0,0,.45);
  border:4px solid transparent;border-image:var(--gd-btn) 8 / 4px stretch;background-clip:padding-box;font-weight:700}
.gs-hudimg{display:block;width:30px;height:auto;pointer-events:none}
#gs-chatb{position:fixed;z-index:6;top:calc(var(--gs-top) + 64px);right:max(10px,env(safe-area-inset-right));width:52px;height:46px;padding:0;border:0;background:none;cursor:pointer}
#gs-chatb[hidden]{display:none}
#gs-chatb .gs-hudimg{width:48px}
@media (min-width:900px),(orientation:landscape) and (min-width:560px){#gs-chatb{right:calc(var(--gs-side) + 10px)}}
html.gs .pad{bottom:calc(var(--gs-sheet) + 10px);transition:bottom .24s cubic-bezier(.2,.8,.2,1),opacity .15s;z-index:5}
html.gs .pad.left{left:max(8px,env(safe-area-inset-left))}
html.gs .pad.right{right:max(8px,env(safe-area-inset-right))}
html.gs .pad img{height:68px}
#gs-keys{display:none;position:fixed;left:14px;bottom:14px;z-index:5;flex-wrap:wrap;gap:6px 14px;max-width:calc(100vw - var(--gs-side) - 28px);pointer-events:none;
  font-size:12px;color:#e6e9f2;text-shadow:0 1px 2px rgba(0,0,0,.7)}
#gs-keys span{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}
#gs-keys kbd{font:700 11px/1 system-ui,sans-serif;min-width:22px;padding:5px 6px;border-radius:6px;text-align:center;background:rgba(18,20,27,.85);border:1px solid var(--gs-line);border-bottom-width:2px}

/* ---- the panel: a bottom sheet ---- */
html.gs #panel{display:flex!important;top:auto;left:0;right:0;bottom:0;width:auto;height:var(--gs-tallh);z-index:7;background:var(--gs-bg);border:0;border-top:1px solid var(--gs-line);
  border-radius:18px 18px 0 0;box-shadow:0 -10px 30px rgba(0,0,0,.45);will-change:transform;transition:transform .24s cubic-bezier(.2,.8,.2,1);
  padding:0 env(safe-area-inset-right) 0 env(safe-area-inset-left)}
#gs-head{flex:none;position:relative;touch-action:none;user-select:none;-webkit-user-select:none}
#gs-grab{display:block;position:relative;width:100%;height:26px;padding:0;border:0;background:none;cursor:grab}
#gs-grab::before{content:'';display:block;width:44px;height:5px;margin:0 auto;border-radius:3px;background:#4b5269}
#gs-grab::after{content:'';position:absolute;inset:-18px 0 0}          /* a 44 px target without a taller bar */
/* phone: the menu put away altogether (#gs-hide in the sheet's corner) and brought back (#gs-show, bottom middle) */
#gs-hide{position:absolute;top:0;right:6px;z-index:3;width:44px;height:30px;padding:0;border:0;background:none;color:#aab2cc;font-size:18px;line-height:1}
#gs-show{display:none;position:fixed;left:50%;transform:translateX(-50%);bottom:calc(6px + env(safe-area-inset-bottom));z-index:6;width:44px;height:34px;padding:0;border-radius:999px;
  border:1px solid #333a50;background:rgba(18,21,32,.85);color:#e6e9f5;font:600 13px system-ui,sans-serif}
html.gs.gs-hid #gs-show{display:block}
html.gs.gs-hid #panel{pointer-events:none}
#gs-tabs{display:flex;gap:2px;padding:0 6px 8px}
.gs-tab{flex:1;min-width:0;height:52px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;border:0;border-radius:12px;background:none;color:var(--dim);
  cursor:pointer;font-size:11px;font-weight:700;-webkit-tap-highlight-color:transparent}
.gs-tab[hidden]{display:none}
.gs-tab span{max-width:100%}
#gs-world{flex:none}
#gs-world button[hidden]{display:none}
/* item settings: the page's .cfg box is shown only for the chip whose gear was tapped, under the worn row */
html.gs #wearing .cfg{display:none}
html.gs .worn .gs-gear{width:auto;height:34px;padding:0 10px;margin-left:6px;gap:5px;display:inline-flex;align-items:center;justify-content:center;color:var(--gs-acc);border:1px solid var(--gs-acc);border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap}
html.gs .worn:has(.gs-gear){max-width:320px}
html.gs #gs-cfg .cfg input[type=range]{flex:1 1 90px;min-width:90px;max-width:180px;height:36px}
html.gs #gs-cfg .cfg label{flex-wrap:wrap}
.gs-gear svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
html.gs .worn.gs-set{box-shadow:inset 0 0 0 1px var(--gs-acc)}
#gs-cfg{flex:none;max-height:46vh;overflow-y:auto;overscroll-behavior:contain;border-radius:12px}
#gs-cfg[hidden]{display:none}
html.gs #gs-cfg .cfg{display:flex;flex-wrap:wrap;white-space:normal;margin:0;gap:8px;padding:10px;border-radius:12px;background:var(--gs-card);font-size:13px}
html.gs #gs-cfg .cfg button{min-height:40px;padding:0 14px;opacity:1;border-color:var(--gs-line)}
html.gs #gs-cfg .cfg button.on{border-color:var(--gs-acc);color:var(--gs-acc)}
html.gs #gs-cfg .cfg label{min-height:40px;gap:8px}
html.gs #gs-cfg .cfg select{height:40px}
html.gs #gs-cfg .cfg input[type=color]{width:44px;height:36px}
html.gs .h:empty,html.gs #gflaghint:empty{display:none}
.gs-tab span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gs-tab svg{width:18px;height:18px}
.gs-tab.on{background:var(--gs-card);color:var(--text);box-shadow:inset 0 0 0 1px var(--gs-line)}
.gs-tab.on svg{color:var(--gs-acc)}
html.gs .pane{display:none!important;flex:none;height:calc(var(--gs-sheet) - var(--gs-head));padding:2px 12px calc(10px + env(safe-area-inset-bottom));gap:10px;overscroll-behavior:contain}
html.gs .pane.gs-on{display:flex!important}
html.gs.gs-s0 .pane{visibility:hidden}

/* ---- inside the panes ---- */
html.gs input.field{height:44px;border-radius:12px;background:var(--gs-card);border-color:var(--gs-line)}
html.gs input.field::placeholder{color:#7d8498}
#gs-tools{display:flex;gap:8px;flex:none}
#gs-tools input{flex:1;min-width:0}
#gs-reset{flex:none;height:44px;padding:0 14px;border-radius:12px;border:1px solid var(--gs-line);background:var(--gs-card);color:var(--text);cursor:pointer;font-weight:700;font-size:13px}
#gs-reset:hover{border-color:var(--dim)}
html.gs #wearing{display:flex;gap:6px;overflow-x:auto;overflow-y:hidden;max-height:none;min-height:48px;flex:none;align-items:center;scrollbar-width:none;margin:0 -12px;padding:0 12px}
html.gs #wearing::-webkit-scrollbar,html.gs #filters::-webkit-scrollbar{display:none}
html.gs #wearing:empty::before{content:attr(data-empty);font-size:12.5px;color:var(--dim);font-weight:400}
html.gs .worn{flex:0 0 auto;max-width:210px;height:48px;padding:0 0 0 12px;gap:2px;border-radius:12px;background:var(--gs-card)}
html.gs .worn button{flex:none;width:44px;height:48px;font-size:20px;border-radius:12px}
html.gs .worn button:hover{color:#ff8f8f}
html.gs .worn em.gsn{display:none}
html.gs .cfg{flex:0 0 auto;margin:0;flex-wrap:nowrap;white-space:nowrap}
html.gs #filters{flex-wrap:nowrap;overflow-x:auto;gap:6px;flex:none;scrollbar-width:none;margin:0 -12px;padding:4px 12px}
html.gs #filters button{position:relative;flex:none;height:36px;padding:0 14px;font-size:13px;border-color:var(--gs-line);color:#c3c8d6}
html.gs #filters button::after{content:'';position:absolute;inset:-4px 0}
html.gs #filters button.on{color:#2a2000}
html.gs #count{font-size:10.5px}
html.gs #grid{grid-template-columns:repeat(auto-fill,minmax(58px,1fr));min-height:0;overscroll-behavior:contain}
html.gs .it{border-radius:10px;background:var(--gs-card)}
html.gs .it.on{background:var(--well-on)}
html.gs:not(.gs-info) .it.nb::after{width:5px;height:5px;opacity:.55}
/* owner 2026-10-07: no item notes in this skin at all -- no purple "guessed" mark, no notes, no menu entry, no "Guessed" filter (the last chip) */
html.gs .it.gs::before{display:none!important}
/* an item with settings: a small gear dot in the picker */
html.gs .it.hc{position:relative}
html.gs .it.hc::before{content:'\2699';display:block!important;position:absolute;top:2px;left:4px;font:700 11px/1 system-ui,sans-serif;color:var(--gs-acc);background:none;padding:0}
html.gs .pane .note{display:none!important}
html.gs #gs-m-info,html.gs #filters button:last-child{display:none!important}
html.gs #subtabs button{min-height:44px;padding:0 2px;font-size:13px}
html.gs .chips button,html.gs .rows button,html.gs .own{min-height:44px;background:var(--gs-card);border-color:var(--gs-line)}
html.gs .chips button.on,html.gs .rows button.on{background:var(--well-on);border-color:var(--gold)}
html.gs .wxgrid{padding:0;grid-template-columns:repeat(auto-fill,minmax(112px,1fr))}
html.gs .wxgrid button{background:var(--gs-card);font-size:12px}

/* ---- a Growtopia text dialog (gs_ui.js gtDialog): the client's RectRender box and buttons, its pictures and font.
   Fill / border colours and textures are the lib's (audit\gs_dialog.md); the 9-slice cut (8 px) and the css sizes are ours. */
.gs-dlg{position:fixed;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;padding:16px}
.gs-dlg .gd{position:relative;width:min(560px,100%);max-height:calc(100vh - 32px);display:flex;background:rgba(39,125,159,.824);
  border:8px solid transparent;border-image:var(--gd-box) 8 / 8px stretch;background-clip:padding-box;image-rendering:pixelated}
.gs-dlg .gd-in{flex:1;overflow-y:auto;padding:12px 12px 14px;display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.gs-dlg canvas{display:block;image-rendering:auto;pointer-events:none}
.gd-lbl{display:flex;align-items:center;gap:8px}
.gd-ic{flex:none;width:48px;height:48px;background-repeat:no-repeat;image-rendering:pixelated}
.gd-sp.small{height:6px}.gd-sp.big{height:18px}
.gd-btn{align-self:stretch;display:flex;justify-content:center;align-items:center;min-height:44px;padding:9px 20px;cursor:pointer;
  background:rgb(135,184,204);border:6px solid transparent;border-image:var(--gd-btn) 8 / 6px stretch;background-clip:padding-box}
.gd-btn:active{filter:brightness(.85)}
.gd-cb{display:flex;align-items:center;gap:8px;min-height:44px;padding:0;border:0;background:none;cursor:pointer}
.gd-cb i{flex:none;width:32px;height:32px;background:url(atlas/ui/dlg_checkbox.png) 0 0/64px 32px no-repeat}
.gd-cb.on i{background-position:-32px 0}
.gd-end{align-self:stretch;display:flex;gap:8px}
.gd-end .gd-btn{flex:1}
.gd-x{position:absolute;top:-4px;right:-4px;width:44px;height:44px;border:0;cursor:pointer;background:url(atlas/ui/dlg_cross.png) center/30px no-repeat}
/* text input: the client's box (fill 0x9f7d27a0 = rgba 39,125,159,.63, gui_box_white border tinted 135,184,204: 0x16a5084) */
.gd-ti{align-self:stretch;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.gd-field{flex:1;min-width:120px;min-height:40px;padding:4px 8px;color:#fff;font-family:'Century Gothic','Trebuchet MS',sans-serif;outline:0;
  background:rgba(39,125,159,.63);border:6px solid transparent;border-image:var(--gd-box) 8 / 6px stretch;background-clip:padding-box}
.gd-lb{border:0;background:none;padding:2px 0;cursor:pointer;text-align:left}
.gd-lb:active{filter:brightness(.8)}
.gd-btn[disabled]{opacity:.5;cursor:default}
.gd-grid{align-self:stretch;display:grid;grid-template-columns:repeat(auto-fill,minmax(56px,1fr));gap:4px;max-height:50vh;overflow-y:auto}
.gd-it{height:56px;border:0;background:rgba(0,0,0,.2);display:flex;align-items:center;justify-content:center;cursor:pointer}
.gd-pick{z-index:41}
/* icon-button lists (add_button_with_icon / add_checkicon); the frame = a cell of game/gui_itembox.rttex (gs_ui.js tileOf),
   40 px cells shown 1.5x (60 css px, the icon 48 x 0.8 inside) */
.gd-ibl{align-self:stretch;display:flex;flex-wrap:wrap;gap:6px}
.gd-br{flex-basis:100%;height:0}
.gd-tile{position:relative;min-width:64px;min-height:64px;padding:2px;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;
  background:none;border:0}
.gd-fr{display:flex;align-items:center;justify-content:center;width:60px;height:60px;background:url(atlas/ui/dlg_itembox.png) 0 0/384px 384px no-repeat;image-rendering:pixelated}
.gd-tile.off .gd-ic{opacity:.3}
.gd-tile[disabled]{opacity:.5;cursor:default}
.gd-am{position:absolute;right:5px;top:38px}
textarea.gd-field{resize:vertical;min-height:72px}

/* ---- SIDE layout: the panel fixed at the right, always open ---- */
@media (min-width:900px),(orientation:landscape) and (min-width:560px){
  html.gs #stage,#gs-bar{right:var(--gs-side)}
  html.gs .dock{display:none}
  html.gs #panel{top:0;left:auto;width:var(--gs-side);height:auto;transform:none!important;border-top:0;border-left:1px solid var(--gs-line);border-radius:0;box-shadow:none;
    padding:env(safe-area-inset-top) env(safe-area-inset-right) 0 0}
  #gs-grab,#gs-hide{display:none}
  /* side layout: one handle on the panel's edge puts the panel away (the stage takes the whole width) and brings it back */
  html.gs #gs-show{display:block;left:auto;right:var(--gs-side);top:50%;bottom:auto;transform:translateY(-50%);width:26px;height:72px;border-radius:12px 0 0 12px;border-right:0;font-size:16px}
  html.gs.gs-hid{--gs-side:0px}
  html.gs.gs-hid #panel{display:none}
  #gs-tabs{padding-top:8px}
  html.gs .pane{flex:1;height:auto;visibility:visible!important;padding-bottom:10px}
  #gs-foot{display:block}
  html.gs #emotes{right:calc(var(--gs-side) + 112px)}
  html.gs .zoom{right:calc(var(--gs-side) + 10px)}
  html.gs .pad{bottom:calc(12px + env(safe-area-inset-bottom))}
  html.gs .pad.right{right:calc(var(--gs-side) + 10px)}
  #gs-menu{right:calc(var(--gs-side) + 8px)}
  #gs-toast{left:calc((100vw - var(--gs-side)) / 2)}
}
@media (min-width:900px) and (hover:hover) and (pointer:fine){            /* a mouse and a keyboard: hints instead of the touch pads */
  html.gs .pad{display:none}
  #gs-keys{display:flex}
}
@media (min-width:1100px){
  .gs-ib .l{display:inline}
  html.gs #emotes{max-height:94px}
}
@media (max-width:400px){html.gs .pad img{height:60px}}
@media (max-height:480px){html.gs .pad img{height:56px}#gs-foot{display:none}}
@media (max-width:340px){html.gs .pad img{height:52px}html.gs .pad{gap:4px}}
@media (max-width:400px){html.gs .pad img{height:60px}}
@media (prefers-reduced-motion:reduce){html.gs #panel,html.gs .pad{transition:none}}
